{
  "name": "brain-tumor-detection-server",
  "version": "1.0.0",
  "description": "Backend for Brain Tumor Detection application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
  "test": "jest --passWithNoTests",
  "test:unit": "jest __tests__/unit --passWithNoTests",
  "test:e2e": "jest __tests__/system --runInBand",
  "test:watch": "jest --watch",
    "test:unit:log": "mkdir -p test-results && jest __tests__/unit --runInBand --verbose --reporters=default --json --outputFile=test-results/unit.json 2>&1 | tee test-results/unit.log",
    "test:system:log": "mkdir -p test-results && jest __tests__/system --runInBand --verbose --reporters=default --json --outputFile=test-results/system.json 2>&1 | tee test-results/system.log",
    "test:all:log": "npm run test:unit:log && npm run test:system:log"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "mongoose": "^7.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
  "jest": "^29.7.0",
  "mongodb-memory-server": "^10.1.4",
  "nodemon": "^3.1.10",
  "supertest": "^7.0.0"
  }
}
